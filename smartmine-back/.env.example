# SmartMine Environment Configuration
APP_NAME="SmartMine API"
APP_ENV=development
DEBUG=true

# Database
DATABASE_URL=sqlite:///./smartmine.db

# CORS (Frontend origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# ==============================================================================
# AI Provider Configuration
# ==============================================================================
# Provider options: "google" (Gemini), "openai" (OpenAI/Groq/OpenRouter/Ollama), "custom"
AI_PROVIDER=google

# For Google Gemini (you can set AI_API_KEY, GEMINI_API_KEY, or GOOGLE_API_KEY)
AI_API_KEY=
# GEMINI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-2.5-flash

# For OpenAI / Groq / OpenRouter / DeepSeek / Ollama:
# AI_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# AI_MODEL=gpt-4o-mini
# AI_BASE_URL=https://api.openai.com/v1   # (or https://api.groq.com/openai/v1 or http://localhost:11434/v1)
